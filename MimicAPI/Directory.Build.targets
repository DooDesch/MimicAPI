<?xml version="1.0" encoding="utf-8"?>
<Project>
    <!-- Ein eigenes Directory.Build.targets beendet die Suche nach oben. Ohne diese Zeilen sieht
         MimicAPI die Deploy-Vorgabe des uebergeordneten Arbeitsbereichs nicht und kopiert nach
         PluginsPath, also in die echte Spielinstallation. Der Pfad wird zur Bauzeit gesucht und
         enthaelt keine Maschinenangabe; fehlt die Datei, passiert nichts.
         Der Umweg ueber eine Property ist noetig, weil eine Condition keine verschachtelten
         Anfuehrungszeichen vertraegt (MSB4092). -->
    <PropertyGroup>
        <MimicParentBuildTargets>$([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildThisFileDirectory)../'))</MimicParentBuildTargets>
    </PropertyGroup>
    <Import Project="$(MimicParentBuildTargets)" Condition="'$(MimicParentBuildTargets)' != '' And Exists('$(MimicParentBuildTargets)')" />

    <!-- Fail early with an actionable message if the game / MelonLoader paths are
         not configured. See Directory.Build.props for how to set GamePath. -->
    <Target Name="VerifyGamePaths" BeforeTargets="ResolveAssemblyReferences">
        <Error Condition="!Exists('$(GameAssemblyPath)\Assembly-CSharp.dll')"
               Text="MIMESIS assemblies not found at GameAssemblyPath '$(GameAssemblyPath)'. Set the game location via -p:GamePath=..., the MIMESIS_PATH environment variable, or a Directory.Build.user.props (see Directory.Build.props)." />
        <Error Condition="!Exists('$(MelonLoaderPath)\MelonLoader.dll')"
               Text="MelonLoader assemblies not found at MelonLoaderPath '$(MelonLoaderPath)'. Install MelonLoader into the game folder (MelonLoader\net35) or override MelonLoaderPath." />
    </Target>

    <Target Name="CopyToPlugins" AfterTargets="Build" Condition="'$(PluginsPath)' != '' And Exists('$(PluginsPath)')">
        <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(PluginsPath)\$(TargetFileName)" />
        <Message Text="Copied to Plugins: $(TargetFileName)" Importance="high" />
    </Target>
</Project>
