<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <!-- The tag gives the version. Without this the DLL always said 1.0.0, and no consumer
             could tell two builds apart. -->
        <Version Condition="'$(Version)' == ''">0.0.0-dev</Version>
        <Nullable>enable</Nullable>
        <WarningLevel>4</WarningLevel>
        <NoWarn>$(NoWarn);MSB3277;MSB3270;MSB3245</NoWarn>
    </PropertyGroup>
    <!-- The reference set the compiler asks for by name. It used to be the whole Managed folder,
         200 entries, because nobody could tell which ones were load bearing - so every game update
         meant re-pointing 200 hint paths, and any reference change was a 200 line diff. -->
    <ItemGroup>
        <Reference Include="0Harmony">
            <HintPath>$(MelonLoaderPath)\0Harmony.dll</HintPath>
        </Reference>
        <Reference Include="MelonLoader">
            <HintPath>$(MelonLoaderPath)\MelonLoader.dll</HintPath>
        </Reference>
        <Reference Include="Assembly-CSharp">
            <HintPath>$(GameAssemblyPath)\Assembly-CSharp.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine">
            <HintPath>$(GameAssemblyPath)\UnityEngine.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <HintPath>$(GameAssemblyPath)\UnityEngine.CoreModule.dll</HintPath>
        </Reference>
    </ItemGroup>
</Project>
