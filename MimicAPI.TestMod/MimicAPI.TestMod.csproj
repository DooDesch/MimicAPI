<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <Nullable>enable</Nullable>
        <WarningLevel>4</WarningLevel>
        <NoWarn>$(NoWarn);MSB3277;MSB3270</NoWarn>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\MimicAPI\MimicAPI.csproj" />
    </ItemGroup>
    <!-- The reference set the compiler asks for by name. It used to be the whole Managed folder,
         200 entries, because nobody could tell which ones were load bearing - so every game update
         meant re-pointing 200 hint paths, and any reference change was a 200 line diff. -->
    <ItemGroup>
        <Reference Include="0Harmony">
            <HintPath>$(MelonLoaderPath)\0Harmony.dll</HintPath>
        </Reference>
        <Reference Include="MelonLoader">
            <HintPath>$(MelonLoaderPath)\MelonLoader.dll</HintPath>
        </Reference>
        <Reference Include="Assembly-CSharp">
            <HintPath>$(GameAssemblyPath)\Assembly-CSharp.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine">
            <HintPath>$(GameAssemblyPath)\UnityEngine.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <HintPath>$(GameAssemblyPath)\UnityEngine.CoreModule.dll</HintPath>
        </Reference>
        <!-- The GUI library this test harness draws with. It ships in Libs/ next to this project.
             It used to be resolved from $(PluginsPath), which is a deploy target and not a place to
             read references from: the file is not there, so the build only stayed green because a
             stale copy sat in bin/ and RAR fell back to the output folder. A clean checkout failed. -->
        <Reference Include="shadcnui">
            <HintPath>$(MSBuildThisFileDirectory)Libs\shadcnui.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.IMGUIModule">
            <HintPath>$(GameAssemblyPath)\UnityEngine.IMGUIModule.dll</HintPath>
        </Reference>
    </ItemGroup>
</Project>
