<?xml version="1.0" encoding="utf-8"?>
<Project>
    <!--
        Inherit the generic, overridable game-path resolution from the MimicAPI
        project so both build configurations stay in sync. Configure the game
        location via -p:GamePath=..., the MIMESIS_PATH environment variable, or a
        gitignored Directory.Build.user.props (see MimicAPI/Directory.Build.props).
    -->
    <Import Project="$(MSBuildThisFileDirectory)..\MimicAPI\Directory.Build.props" />
</Project>
